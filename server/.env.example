AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3.2
AI_API_KEY=
PORT=8787
WEBNESTDEV_DATA_DIR=.webnestdev
# Required to save provider/GitHub credentials; 32 random bytes as 64 hex chars or base64.
# Generate with: openssl rand -hex 32
WEBNESTDEV_ENCRYPTION_KEY=
# Dedicated secret for HMAC-hashing phone OTPs; generate with: openssl rand -hex 32
WEBNESTDEV_PHONE_OTP_SECRET=
# Keep stable across deployments; generate once with: openssl rand -hex 32
WEBNESTDEV_TRIAL_CLAIM_SECRET=
# console is local-only; use smsru with SMSRU_API_ID in production
WEBNESTDEV_SMS_MODE=console
SMSRU_API_ID=
WEBNESTDEV_SMS_MAX_PER_HOUR=100
WEBNESTDEV_PHONE_CONSENT_VERSION=phone-auth-v1
WEBNESTDEV_SANDBOX_DIR=.webnestdev/sandboxes
AGENT_MAX_STEPS=12
TOOL_COMMAND_TIMEOUT_MS=120000
TOOL_COMMAND_MAX_OUTPUT=200000
SANDBOX_MODE=docker
SANDBOX_IMAGE=node:22-bookworm-slim
SANDBOX_MEMORY=1g
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1
SANDBOX_CPU_LIMIT=1
SANDBOX_PIDS_LIMIT=128
SANDBOX_NETWORK=none
