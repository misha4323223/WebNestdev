# Фронт для платформы: HTTPS для панели и для публичных адресов предпросмотра.
#
# Файл приезжает на ВМ вместе с docker-compose.yml (deploy/scripts/vm-deploy.sh) и монтируется в
# контейнер caddy. Значения подставляются переменными окружения контейнера (см. docker-compose.yml):
#
#   WEBNESTDEV_SITE_DOMAIN  — домен панели и API (например nestdev.ru)
#   PREVIEW_PUBLIC_DOMAIN   — домен публичных предпросмотров (например preview.nestdev.ru)
#   ACME_EMAIL              — адрес для Let's Encrypt: о проблемах с сертификатами он напишет сюда
#
# Панель и публичные предпросмотры идут в один и тот же контейнер сервера, но на разные порты:
# 8787 — панель, API и WebSocket агента, 8788 — дверь публичных предпросмотров (приложение проекта
# занимает там весь путь, включая `/api`, и живой WebSocket; см. server/src/preview/preview-host-server.ts).
{
	email {$ACME_EMAIL:nestdev@mail.ru}

	# Сертификат на имя предпросмотра выдаётся по запросу: поддомены появляются вместе с проектами,
	# и заранее их список неизвестен. Спросить разрешение Caddy обязан — иначе любой, кто направит
	# на эту ВМ своё имя в нашем домене, получил бы сертификат Let's Encrypt, а лимит выдачи на домен
	# (50 сертификатов в неделю) исчерпывался бы чужими запросами. Endpoint отвечает 200 только для
	# имён существующих проектов и 404 для всего остального:
	#   server/src/routes/preview.ts → GET /api/preview/tls-ask
	# Ограничители частоты (interval/burst) здесь намеренно не заданы: в Caddy 2.9 они уже не
	# поддерживаются, а защитой служит сам ответ endpoint — выдача начинается только для того имени,
	# которое принадлежит проекту на этом сервере, и полученный сертификат потом берётся из кэша.
	on_demand_tls {
		ask http://webnestdev-server:8787/api/preview/tls-ask
	}
}

# Панель и API. WebSocket (`/ws` — прогоны агента) Caddy проксирует сам, отдельной настройки не нужно.
{$WEBNESTDEV_SITE_DOMAIN:localhost}, www.{$WEBNESTDEV_SITE_DOMAIN:localhost} {
	# Один адрес вместо двух: `www` переводится на основной домен. Иначе вход и CORS пришлось бы
	# разрешать для обоих имён (WEBNESTDEV_ALLOWED_ORIGINS), а cookie сессии — делить между ними.
	@www host www.{$WEBNESTDEV_SITE_DOMAIN:localhost}
	redir @www https://{$WEBNESTDEV_SITE_DOMAIN:localhost}{uri} permanent

	encode zstd gzip
	reverse_proxy webnestdev-server:8787
}

# Публичный адрес предпросмотра проекта: `<проект>.preview.nestdev.ru`. Приложение отдаётся в корне
# своего имени — ссылки, абсолютные пути и живая перезагрузка работают как при обычном запуске.
# Доступ к адресу даёт билет, который панель просит у сервера: cookie сессии панели на поддомен не
# отправляется, а расширять её до всего домена нельзя (прокси передаёт приложение заголовки запроса,
# то есть код пользователя увидел бы cookie платформы).
*.{$PREVIEW_PUBLIC_DOMAIN:preview.localhost} {
	# Сертификат на конкретное имя (`p1.preview.nestdev.ru`) Caddy получает в момент первого
	# обращения к нему, а не заранее: имена проектов появляются вместе с проектами. Полученные
	# сертификаты лежат в томе caddy-data (см. docker-compose.yml) — без него каждая выкатка
	# начиналась бы с пустого хранилища и снова просила бы сертификаты на каждый проект.
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy webnestdev-server:8788
}
