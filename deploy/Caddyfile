# Фронт для платформы: HTTPS для панели и для публичных адресов предпросмотра.
#
# Файл приезжает на ВМ вместе с docker-compose.yml (deploy/scripts/vm-deploy.sh) и монтируется в
# контейнер caddy. Значения подставляются переменными окружения контейнера (см. docker-compose.yml):
#
#   WEBNESTDEV_SITE_DOMAIN  — домен панели и API (например nestdev.ru)
#   PREVIEW_PUBLIC_DOMAIN   — домен публичных предпросмотров (например preview.nestdev.ru)
#   ACME_EMAIL              — адрес для Let's Encrypt: о проблемах с сертификатами он напишет сюда
#
# Панель и публичные предпросмотры идут в один и тот же контейнер сервера, но на разные порты:
# 8787 — панель, API и WebSocket агента, 8788 — дверь публичных предпросмотров (приложение проекта
# занимает там весь путь, включая `/api`, и живой WebSocket; см. server/src/preview/preview-host-server.ts).
{
	email {$ACME_EMAIL:nestdev@mail.ru}

	# Сертификат на имя предпросмотра выдаётся по запросу: поддомены появляются вместе с проектами,
	# и заранее их список неизвестен. Спросить разрешение Caddy обязан — иначе любой, кто направит
	# на эту ВМ своё имя в нашем домене, получил бы сертификат Let's Encrypt, а лимит выдачи на домен
	# (50 сертификатов в неделю) исчерпывался бы чужими запросами. Endpoint отвечает 200 только для
	# имён существующих проектов и 404 для всего остального:
	#   server/src/routes/preview.ts → GET /api/preview/tls-ask
	# Ограничители частоты (interval/burst) здесь намеренно не заданы: в Caddy 2.9 они уже не
	# поддерживаются, а защитой служит сам ответ endpoint — выдача начинается только для того имени,
	# которое принадлежит проекту на этом сервере, и полученный сертификат потом берётся из кэша.
	on_demand_tls {
		# Один ask на два поддоменных пространства: preview и статические сайты.
		# Сервер различает их по домену и отвечает 200 только для существующего проекта
		# или live-сайта; для draft/unpublished сертификат не выдаётся.
		ask http://webnestdev-server:8787/api/tls-ask
	}
}

# Пользовательские домены. Файл целиком генерирует API (site_domains + live sites), Caddy читает
# каталог только на чтение. `import` с glob допускает пустой набор, но на свежей ВМ deploy
# заранее создаёт пустой custom-domains.caddy — без него Caddy не примет конфиг.
import /etc/caddy/custom/*.caddy

# Панель и API. WebSocket (`/ws` — прогоны агента) Caddy проксирует сам, отдельной настройки не нужно.
{$WEBNESTDEV_SITE_DOMAIN:localhost}, www.{$WEBNESTDEV_SITE_DOMAIN:localhost} {
	# Один адрес вместо двух: `www` переводится на основной домен. Иначе вход и CORS пришлось бы
	# разрешать для обоих имён (WEBNESTDEV_ALLOWED_ORIGINS), а cookie сессии — делить между ними.
	@www host www.{$WEBNESTDEV_SITE_DOMAIN:localhost}
	redir @www https://{$WEBNESTDEV_SITE_DOMAIN:localhost}{uri} permanent

	encode zstd gzip
	reverse_proxy webnestdev-server:8787
}

# Публичный адрес предпросмотра проекта: `<проект>.preview.nestdev.ru`. Приложение отдаётся в корне
# своего имени — ссылки, абсолютные пути и живая перезагрузка работают как при обычном запуске.
# Доступ к адресу даёт билет, который панель просит у сервера: cookie сессии панели на поддомен не
# отправляется, а расширять её до всего домена нельзя (прокси передаёт приложение заголовки запроса,
# то есть код пользователя увидел бы cookie платформы).
# Статические сайты проекта: `<slug>.host.nestdev.ru`. Ссылка `current` относительная и
# создаётся только сервером; expression проверяет, что slug — DNS-метка из 3–63 строчных
# латинских букв, цифр и дефисов, а не произвольный Host. Caddy читает SITES_DIR только
# на чтение.
*.{$HOSTING_PUBLIC_DOMAIN:host.nestdev.ru} {
	# TLS приходит отдельным файлом-сниппетом, как у preview: после выпуска wildcard
	# `*.host.nestdev.ru` по DNS-01 скрипт переключает его на статический сертификат.
	# On-demand для нового имени здесь не работает: ACME-челлендж приходит на CDN и
	# получает 504, пока у origin нет сертификата (см. deploy/host-tls.caddy).
	import /etc/caddy/host-tls.caddy

	# Режимы платформенных сайтов и их canonical-хосты. Файл генерирует API из базы;
	# `map` допустим только внутри site-блока, поэтому import стоит здесь, а не на верхнем
	# уровне Caddyfile. Один map обслуживает все `*.host` без блока на каждый сайт. На свежей
	# ВМ deploy создаёт `default "spa" "" "ignore"`, пока API не перезаписал файл; старый map
	# с тремя колонками заменяется при выкатке.
	import /etc/caddy/custom/hosting-modes.map

	encode zstd gzip

	# Корень задан на уровне сайта: `file_server` внутри `handle_errors` сохраняет
	# исходный статус 404 только когда сайт уже знает свой root. Конкретный slug ниже
	# всё равно проверяется matcher'ом, поэтому невалидный Host не читает чужой каталог.
	root * /srv/sites/{http.request.host.labels.3}/current

	# `hosting_canonical` непустой только после активации custom domain. Сам
	# платформенный адрес при этом не отдаёт контент, а делает постоянный 301.
	@canonical_redirect `{hosting_canonical} != '' && {http.request.host} != {hosting_canonical}`
	redir @canonical_redirect https://{hosting_canonical}{uri} permanent

	# labels.3 — slug только для домена из трёх меток (host.nestdev.ru). Если домен станет
	# host.staging.nestdev.ru, индекс нужно пересчитать и проверить в smoke, а не угадывать.
	@site `{http.request.host.labels.3}.matches('^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$')`
	handle @site {
		# 404.html — только шаблон ошибки, а не обычная страница с 200.
		@errorfile path /404.html
		respond @errorfile 404

		# Скрытые файлы и служебные каталоги. `hide` не является границей безопасности,
		# поэтому они ещё и не попадают в артефакт при публикации.
		@hidden {
			path_regexp dot (^|/)\.
			not path /.well-known/*
		}
		respond @hidden 404
		# `_redirects` — входной файл маршрутизации, а не публичная страница.
		@redirects_file path /_redirects
		respond @redirects_file 404

		@html path / *.html
		header @html Cache-Control "no-cache"

		# sitemap/robots/проверка Search Console не должны жить в CDN год.
		@seo path /sitemap.xml /sitemap-*.xml /robots.txt /google*.html
		header @seo Cache-Control "public, max-age=300"

		# Годовая immutable-кешировка только для файлов с хешем в имени. Обычный
		# /assets/logo.png не должен получить max-age=31536000.
		@hashed path_regexp hashed -[A-Za-z0-9_-]{6,}\.[a-z0-9]{1,8}$
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
		}

		# Serverless API сайта. Отдельная дверь отвечает 404, если функции на путь нет;
		# SPA-fallback ниже не должен подменять отсутствующий API страницей.
		handle /api/* {
			reverse_proxy webnestdev-server:8792
		}

		# Пользовательский sitemap/robots главнее сгенерированного overlay.
		handle /sitemap.xml {
			root * /srv/sites/{http.request.host.labels.3}
			try_files /current/sitemap.xml /seo/sitemap.xml
			file_server
		}
		handle /sitemap-*.xml {
			root * /srv/sites/{http.request.host.labels.3}
			try_files /current{path} /seo{path}
			file_server
		}
		handle /robots.txt {
			root * /srv/sites/{http.request.host.labels.3}
			try_files /current/robots.txt /seo/robots.txt
			file_server
		}
		# Search Console подтверждает владение файлом google<token>.html; он лежит в overlay.
		handle /google*.html {
			root * /srv/sites/{http.request.host.labels.3}
			try_files /current{path} /seo{path}
			file_server
		}

		# Пользовательские редиректы из _redirects активного релиза. Они идут раньше
		# trailing slash: правило /old -> /new должно сработать и при политике always,
		# иначе первый ответ уводил бы /old на /old/ и правило уже не совпало бы.
		import /etc/caddy/custom/hosting-redirects.map

		# Один вариант trailing slash; второй отвечает 301.
		@slash_add {
			expression {hosting_slash} == 'always'
			path_regexp slash ^(/.+[^/])$
			not path_regexp ext (?i)\.[a-z0-9]{1,16}$
			not path /api/* /.well-known/*
		}
		redir @slash_add {http.request.uri.path}/{?query} permanent
		@slash_remove {
			expression {hosting_slash} == 'never'
			path_regexp slash ^(/.+[^/])/$
			not path /api/* /.well-known/*
		}
		redir @slash_remove {re.slash.1}{?query} permanent

		# Режим берётся из map, а не из наличия index.html: Caddy не читает файлы для
		# маршрутизации и не угадывает SPA по 200 на случайном пути.
		@mode_static `{hosting_mode} == 'static'`
		handle @mode_static {
			try_files {path} {path}/index.html
			file_server
		}
		@mode_hybrid `{hosting_mode} == 'hybrid'`
		handle @mode_hybrid {
			@hybrid_spa {
				path /app/*
				not path_regexp ext (?i)\.[a-z0-9]{1,16}$
			}
			handle @hybrid_spa {
				try_files {path} /index.html
				file_server
			}
			handle {
				try_files {path} {path}/index.html
				file_server
			}
		}
		@mode_spa `{hosting_mode} == 'spa'`
		handle @mode_spa {
			@spa not path_regexp ext (?i)\.[a-z0-9]{1,16}$
			handle @spa {
				try_files {path} /index.html
				file_server
			}
			handle {
				file_server
			}
		}
	}

	# Неизвестный или невалидный slug: не отдаём чужой каталог и не подставляем панель.
	respond 404

	# 404.html отдаём с исходным статусом 404 и noindex. Для static это важно: без
	# файла остаётся честный 404, а не index.html с кодом 200.
	handle_errors {
		@notfound expression int({http.error.status_code}) == 404
		header @notfound X-Robots-Tag "noindex"
		header @notfound Cache-Control "no-cache"
		root * /srv/sites/{http.request.host.labels.3}/current
		rewrite @notfound /404.html
		file_server
	}
}

# Отдельная дверь для POST-запросов к функциям сайтов. CDN MWS пропускает только
# GET/HEAD/OPTIONS, поэтому формы идут сюда напрямую в NLB, минуя CDN. Путь имеет вид
# `/<slug>/api/...`; сервер сам проверяет slug и снимает префикс.
#
# Хост намеренно вне `*.host.nestdev.ru`: reg.ru не сохраняет A-запись под
# wildcard-CNAME, и `api.host` снова уезжает в CDN. `api.nestdev.ru` — отдельное имя
# с A-записью на NLB; сертификат выпускается on-demand (HTTP-01 идёт напрямую в Caddy).
{$HOSTING_API_HOST:api.nestdev.ru} {
	tls {
		on_demand
	}

	encode zstd gzip
	reverse_proxy webnestdev-server:8792
}

*.{$PREVIEW_PUBLIC_DOMAIN:preview.localhost} {
	# TLS приходит отдельным файлом-сниппетом, потому что у Caddyfile нет условий: схему
	# сертификата выбирает `deploy/scripts/wildcard-cert.sh`, а не сам конфиг.
	#   по умолчанию — `tls { on_demand }`: сертификат на конкретное имя
	#     (`p1.preview.nestdev.ru`) выдаётся в момент первого обращения к нему, а не заранее,
	#     и лежит в томе caddy-data (см. docker-compose.yml) — без него каждая выкатка
	#     начиналась бы с пустого хранилища и снова просила бы сертификаты на каждый проект;
	#   после выпуска wildcard — статический сертификат `*.<домен>` из DNS-01 (/certs).
	import /etc/caddy/preview-tls.caddy
	encode zstd gzip
	reverse_proxy webnestdev-server:8788
}
