# Клиентская база платформы: общие значения для обеих нод.
# Пароли сюда не пишем: они приходят из окружения выкатки или из /etc/webnestdev/client-db.env
# (права 600) и в репозиторий не попадают.

PG_VERSION=17
PG_CLUSTER=client
PG_PORT=5434
PG_DB=app

# Приватный адрес этой ноды: на нём слушает PgBouncer (порт 6432).
# Именно этот адрес попадает в DATABASE_URL клиента, пока нет стабильного DNS.
PRIVATE_IP=

# Приватный адрес второй ноды — для потоковой репликации и проверки роли.
PEER_IP=

REPL_USER=client_replicator
REPL_SLOT=client_standby
# Пароль репликации и пароль администратора схем — только в /etc/webnestdev/client-db.env
# (root:root 600), в репозиторий и в этот пример не попадают.
# REPL_PASSWORD=…
# PGBOUNCER_AUTH_PASSWORD=…  (создаёт primary, standby получает файл целиком)
# CLIENT_DB_ADMIN_URL=…

# Синхронная репликация выключена по умолчанию: при выключенной node-2 запись не встаёт.
# Включать (1), когда обе ноды работают постоянно — тогда RPO 0.
SYNC_REPLICATION=0

# Порог подтверждений перед promotion: 2 — два подряд пропуска второй ноды.
FAILOVER_CONFIRMATIONS=2

# PgBouncer
PGBOUNCER_PORT=6432
PGBOUNCER_LISTEN_PORT=6432

# Квоты и бэкапы
CLIENT_DB_BACKUP_DIR=/var/backups/webnestdev/client-db
CLIENT_DB_BACKUP_KEEP_DAYS=7
