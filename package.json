{
  "name": "webnestdev",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c auto \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build:server && tsc -b && vite build",
    "preview": "vite preview",
    "build:server": "npm run build --workspace=server",
    "start:server": "npm run start --workspace=server",
    "local": "node scripts/local.mjs dev",
    "local:setup": "node scripts/local.mjs setup",
    "local:verify": "node scripts/local.mjs verify"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  },
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=20"
  }
}
