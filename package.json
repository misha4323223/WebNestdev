{
  "name": "webnestdev",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build:server && tsc -b && vite build",
    "preview": "vite preview",
    "build:server": "npm run build --workspace=server",
    "start:server": "npm run start --workspace=server",
    "local": "node scripts/local.mjs dev",
    "local:setup": "node scripts/local.mjs setup",
    "local:verify": "node scripts/local.mjs verify"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4",
    "typescript": "7.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.53.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=20"
  }
}
