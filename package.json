{
  "name": "webnestdev",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build:server && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "test:web": "vitest run",
    "test:web:watch": "vitest",
    "build:server": "npm run build --workspace=server",
    "test:broker": "node --test deploy/docker-broker/*.test.mjs",
    "start:server": "npm run start --workspace=server",
    "start:preview-api": "NODE_ENV=production npm run start --workspace=server",
    "local": "node scripts/local.mjs dev",
    "local:setup": "node scripts/local.mjs setup",
    "local:verify": "node scripts/local.mjs verify"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^31.0.0",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.1.0"
  },
  "preview": {
    "mode": "hybrid",
    "build": "build",
    "staticDir": "dist",
    "backend": "start:preview-api",
    "backendPaths": [
      "/api",
      "/ws"
    ],
    "backendPort": 3000
  },
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@fastify/ajv-compiler": {
      "fast-uri": "4.2.3"
    },
    "fast-json-stringify": {
      "fast-uri": "4.2.3"
    },
    "ajv": {
      "fast-uri": "3.1.9"
    }
  }
}
