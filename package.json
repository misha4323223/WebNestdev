{
  "name": "webnestdev",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build:server && tsc -b && vite build",
    "preview": "vite preview",
    "build:server": "npm run build --workspace=server",
    "test:broker": "node --test deploy/docker-broker/*.test.mjs",
    "start:server": "npm run start --workspace=server",
    "local": "node scripts/local.mjs dev",
    "local:setup": "node scripts/local.mjs setup",
    "local:verify": "node scripts/local.mjs verify"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@fastify/ajv-compiler": {
      "fast-uri": "4.2.3"
    },
    "fast-json-stringify": {
      "fast-uri": "4.2.3"
    },
    "ajv": {
      "fast-uri": "3.1.9"
    }
  }
}
