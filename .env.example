NODE_ENV=development
PORT=8787

# Storage: json for local-only development, ydb for production.
WEBNESTDEV_STORAGE=json
WEBNESTDEV_DATA_DIR=.webnestdev

# YDB production configuration
YDB_CONNECTION_STRING=grpcs://ydb.example.com:2135/your-database
YDB_TOKEN=
YDB_TABLE_PREFIX=webnestdev

# Browser/Preview
WEBNESTDEV_ALLOWED_ORIGINS=http://localhost:5173
PLAYWRIGHT_BROWSERS_PATH=
WEBNESTDEV_BROWSER_EXECUTABLE=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8787/api/github/callback
GITHUB_FRONTEND_URL=http://localhost:5173/

# AI provider
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Sandbox
SANDBOX_MODE=docker
